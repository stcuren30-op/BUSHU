}

function closeInfoModal() {
  document.getElementById('info-modal').classList.add('hidden');
}

function buildBalancedKanjiDB() {
  const targetBushus = ['氵', '扌', '木', '亻', '言', '禾', '宀', '竹'];
  let selected = [];

  targetBushus.forEach(b => {
    const list = KANJI_MASTER_POOL.filter(k => k.bushu === b);
    const shuffled = [...list].sort(() => 0.5 - Math.random());
    selected.push(...shuffled.slice(0, 5));
  });

  return selected;
}

function generateOptimizedDeck() {
  let cardPool = [];
  KANJI_DB.forEach(k => {
    k.parts.forEach(p => {
      cardPool.push({ type: 'PART', value: p, bushu: k.bushu });
    });
  });
  
  SPECIAL_CARDS.forEach(s => {
    cardPool.push({ type: 'SPECIAL', value: s.kanji, effect: s.type });
    cardPool.push({ type: 'SPECIAL', value: s.kanji, effect: s.type });
  });

  for (let i = cardPool.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [cardPool[i], cardPool[j]] = [cardPool[j], cardPool[i]];
  }
  return cardPool;
}

function initGame() {
  if (timerInterval) clearInterval(timerInterval);
  if (cpuTimerId) clearTimeout(cpuTimerId);
  
  KANJI_DB = buildBalancedKanjiDB();

  deck = generateOptimizedDeck(); players = [[], [], [], []]; turn = 0; direction = 1;
  selectedIndices = []; historyCompletedKanji = [];
  bushuDeclared = [false, false, false, false]; pendingDrawCount = 0;
  wildSpecifiedBushu = null; timeRemaining = gameTimeLimitSetting; isGameOver = false;

  const randomKanji = KANJI_DB[Math.floor(Math.random() * KANJI_DB.length)];
  topCard = { type: 'PART', value: randomKanji.kanji, bushu: randomKanji.bushu };
  updateActivePartsFromCard(topCard);

  for (let p = 0; p < 4; p++) {
    const sampleKanji = KANJI_DB.find(k => k.parts.some(pt => activeParts.includes(pt)) || k.bushu === topCard.bushu) || randomKanji;
    if (sampleKanji) {
      sampleKanji.parts.forEach(partVal => {
        players[p].push({ type: 'PART', value: partVal, bushu: sampleKanji.bushu });
      });
    }
    while (players[p].length < 7) {
      if (deck.length > 0) players[p].push(deck.pop());
    }
  }

  fitGameToScreen();
  renderUI();
  updateTurnDisplay();
  startTimer();
}

function updateActivePartsFromCard(card) {
  if (card.type === 'SPECIAL') { activeParts = []; return; }
  wildSpecifiedBushu = null;
  const matched = KANJI_DB.find(k => k.kanji === card.value);
  if (matched) { activeParts = [...matched.parts]; } else { activeParts = [card.value]; }
}

function startTimer() {
  updateTimerDisplay();
  timerInterval = setInterval(() => {
    if (isGameOver) return;
    timeRemaining--; updateTimerDisplay();
    if (timeRemaining <= 0) { clearInterval(timerInterval); handleTimeUp(); }
  }, 1000);
}

function updateTimerDisplay() {
  document.getElementById('timer-value-num').innerText = timeRemaining;
}

function handleTimeUp() {
  isGameOver = true;
  const rankingList = players.map((p, idx) => ({ playerIdx: idx, count: p.length }));
  rankingList.sort((a, b) => a.count - b.count);
  showResultModal(rankingList, true);
}

