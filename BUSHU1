function toggleCardSelect(index) {
  if (turn !== 0 || isGameOver) return;
  const clickedCard = players[0][index];

  if (clickedCard.type === 'SPECIAL') {
    if (selectedIndices.includes(index)) {
      selectedIndices = [];
    } else {
      selectedIndices = [index];
    }
  } else {
    selectedIndices = selectedIndices.filter(i => players[0][i].type !== 'SPECIAL');
    
    const pos = selectedIndices.indexOf(index);
    if (pos > -1) {
      selectedIndices.splice(pos, 1);
    } else {
      selectedIndices.push(index);
    }
  }
  renderUI();
}

function findMatchingKanji(partValues) {
  if (partValues.length < 2) return null;
  const sortedInput = [...partValues].sort().join('');
  return KANJI_DB.find(k => [...k.parts].sort().join('') === sortedInput);
}

function checkPlayedCardsValid(selectedCards) {
  if (selectedCards.length === 0) return false;

  if (selectedCards.some(c => c.type === 'SPECIAL') && selectedCards.length > 1) {
    return false;
  }

  if (pendingDrawCount > 0) {
    if (selectedCards.length === 1 && selectedCards[0].type === 'SPECIAL') {
      const eff = selectedCards[0].effect;
      if (eff === 'DRAW2' || eff === 'DRAW4') return true;
    }
    return false;
  }

  if (selectedCards.length === 1 && selectedCards[0].type === 'SPECIAL') {
    return true;
  }

  const values = selectedCards.map(c => c.value);
  const matchedKanji = findMatchingKanji(values);

  if (matchedKanji) {
    const topBushuKey = wildSpecifiedBushu || topCard.bushu;
    const isSameBushuColor = (matchedKanji.bushu === topBushuKey);
    const hasCommonPart = (activeParts.length === 0) || matchedKanji.parts.some(p => activeParts.includes(p));

    return isSameBushuColor || hasCommonPart;
  }

  return false;
}

function triggerPenaltyWarning() {
  const banner = document.getElementById('penalty-error-banner');
  banner.classList.remove('hidden');

  selectedIndices = [];
  drawCardsSmart(0, 1);
  renderUI();

  setTimeout(() => {
    banner.classList.add('hidden');
    advanceTurn();
    renderUI();
    updateTurnDisplay();
    if (turn !== 0 && !isGameOver) {
      scheduleCpuTurn();
    }
  }, 1800);
}

function submitSelectedCards() {
  if (turn !== 0 || isGameOver) return;
  if (selectedIndices.length === 0) return;

  const selectedCards = selectedIndices.map(i => players[0][i]);

  if (selectedCards.some(c => c.type === 'SPECIAL') && selectedCards.length > 1) {
    triggerSpecialCutin("⚠️ 特殊カードは他のカードと組み合わせて出せません！");
    selectedIndices = [];
    renderUI();
    return;
  }

  const isValidCombo = checkPlayedCardsValid(selectedCards);

  if (!isValidCombo) {
    triggerPenaltyWarning();
    return;
  }

  selectedIndices.sort((a,b) => b - a).forEach(i => players[0].splice(i, 1));
  selectedIndices = [];

  processPlayedCards(selectedCards, 0);
  checkWinOrNextTurn();
}

