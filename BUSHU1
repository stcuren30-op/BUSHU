    renderUI();
  }
}

function processPlayedCards(cards, playerIdx) {
  if (cards.length === 1 && cards[0].type === 'SPECIAL') {
    const sp = cards[0]; topCard = sp; activeParts = [];
    
    const specNames = { 'SKIP': '⚡ スキップ発動！', 'REVERSE': '🔄 リバース発動！', 'DRAW2': '💥 ドロー2攻撃！', 'DRAW4': '🔥 ドロー4大攻撃！', 'WILD': '🎨 ワイルド発動！' };
    triggerSpecialCutin(specNames[sp.effect] || '✨ 特殊カード発動！');

    if (sp.effect === 'SKIP') { advanceTurn(); }
    else if (sp.effect === 'REVERSE') { direction *= -1; }
    else if (sp.effect === 'DRAW2') { pendingDrawCount += 2; }
    else if (sp.effect === 'DRAW4') { pendingDrawCount += 4; }
    else if (sp.effect === 'WILD') {
      if (playerIdx === 0) {
        document.getElementById('wild-modal').classList.remove('hidden'); return;
      } else {
        const bushuList = ['氵', '扌', '木', '禾', '亻', '言', '宀', '竹'];
        const selectedB = bushuList[Math.floor(Math.random() * bushuList.length)];
        activeParts = [selectedB]; wildSpecifiedBushu = selectedB;
      }
    }
  } else {
    const values = cards.map(c => c.value);
    const matched = findMatchingKanji(values);
    if (matched) {
      topCard = { type: 'PART', value: matched.kanji, bushu: matched.bushu };
      activeParts = [...matched.parts]; wildSpecifiedBushu = null;
      historyCompletedKanji.push({ playerIdx: playerIdx, kanji: matched.kanji, parts: matched.parts.join(' + '), bushu: matched.bushu });
      triggerCombineBumpAnimation();
    }
  }
}

function selectWildBushu(bushu) {
  activeParts = [bushu]; wildSpecifiedBushu = bushu;
  document.getElementById('wild-modal').classList.add('hidden');
  checkWinOrNextTurn();
}

