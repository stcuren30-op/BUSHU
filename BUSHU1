function checkWinOrNextTurn() {
  if (isGameOver) return;
  if (players[turn].length === 0) {
    isGameOver = true; if (timerInterval) clearInterval(timerInterval);
    const winnerIdx = turn; const others = [];
    for (let i = 0; i < 4; i++) { if (i !== winnerIdx) others.push({ playerIdx: i, count: players[i].length }); }
    others.sort((a, b) => a.count - b.count);
    showResultModal([{ playerIdx: winnerIdx, count: 0 }, ...others], false);
    return;
  }

  advanceTurn(); renderUI(); updateTurnDisplay();
  
  if (turn === 0 && pendingDrawCount > 0) {
    checkAndAutoProcessPlayerDraw();
    return;
  }

  if (turn !== 0 && !isGameOver) {
    scheduleCpuTurn();
  }
}

function scheduleCpuTurn() {
  if (cpuTimerId) clearTimeout(cpuTimerId);
  cpuTimerId = setTimeout(executeCpuTurn, cpuSpeedMs);
}

function advanceTurn() { turn = (turn + direction + 4) % 4; }

function drawCardsSmart(playerIdx, count) {
  const hand = players[playerIdx];

  for (let c = 0; c < count; c++) {
    if (deck.length === 0) break;

    let targetCardIndex = -1;

    for (let i = 0; i < deck.length; i++) {
      const candidate = deck[i];
      if (candidate.type === 'SPECIAL') { 
        targetCardIndex = i; 
        break; 
      }

      const canFormPairWithHand = hand.some(hCard => {
        if (hCard.type === 'SPECIAL') return false;
        return !!findMatchingKanji([hCard.value, candidate.value]);
      });

      if (canFormPairWithHand) {
        targetCardIndex = i;
        break;
      }
    }

    if (targetCardIndex > -1) {
      const drawnCard = deck.splice(targetCardIndex, 1)[0];
      hand.push(drawnCard);
    } else {
      hand.push(deck.pop());
    }
  }
}

function checkAndAutoProcessPlayerDraw() {
  if (turn !== 0 || pendingDrawCount === 0 || isGameOver) return;

  const hasCounterCard = players[0].some(c => c.type === 'SPECIAL' && (c.effect === 'DRAW2' || c.effect === 'DRAW4'));

  if (!hasCounterCard) {
    setTimeout(() => {
      const hitAmount = pendingDrawCount;
      drawCardsSmart(0, pendingDrawCount);
      pendingDrawCount = 0;
      triggerDrawHitBanner(0, hitAmount, () => {
        advanceTurn();
        renderUI();
        updateTurnDisplay();
        if (turn !== 0 && !isGameOver) scheduleCpuTurn();
      });
    }, 500);
  }
}

function drawFromDeckPlayer() {
  if (turn !== 0 || isGameOver) return;
  
  if (pendingDrawCount > 0) {
    const hitAmount = pendingDrawCount;
    drawCardsSmart(0, pendingDrawCount); 
    pendingDrawCount = 0;
    triggerDrawHitBanner(0, hitAmount, () => {
      advanceTurn(); 
      renderUI(); 
      updateTurnDisplay();
      if (turn !== 0 && !isGameOver) scheduleCpuTurn();
    });
    return;
  } 

  drawCardsSmart(0, 1);
  selectedIndices = [];
  renderUI();
  
  const canPlay = checkPlayerHasAnyValidCombo();
  
  if (canPlay) {
    return;
  } else {
    advanceTurn(); 
    renderUI(); 
    updateTurnDisplay();
    if (turn !== 0 && !isGameOver) {
      scheduleCpuTurn();
    }
  }
}

function checkPlayerHasAnyValidCombo() {
  const hand = players[0];
  if (hand.some(c => c.type === 'SPECIAL')) return true;

  const topBushuKey = wildSpecifiedBushu || topCard.bushu;

  for (let i = 0; i < hand.length; i++) {
    for (let j = i + 1; j < hand.length; j++) {
      const matched = findMatchingKanji([hand[i].value, hand[j].value]);
      if (matched) {
        const hasCommon = activeParts.length === 0 || matched.parts.some(p => activeParts.includes(p));
        const isSameBushu = (matched.bushu === topBushuKey);
        if (hasCommon || isSameBushu) return true;
      }
    }
  }

  for (let i = 0; i < hand.length; i++) {
    for (let j = i + 1; j < hand.length; j++) {
      for (let k = j + 1; k < hand.length; k++) {
        const matched = findMatchingKanji([hand[i].value, hand[j].value, hand[k].value]);
        if (matched) {
          const hasCommon = activeParts.length === 0 || matched.parts.some(p => activeParts.includes(p));
          const isSameBushu = (matched.bushu === topBushuKey);
          if (hasCommon || isSameBushu) return true;
        }
      }
    }
  }

  return false;
}

function updateTurnDisplay() {
  document.getElementById('profile-player').classList.toggle('active', turn === 0);
  document.getElementById('profile-cpu1').classList.toggle('active', turn === 1);
  document.getElementById('profile-cpu2').classList.toggle('active', turn === 2);
  document.getElementById('profile-cpu3').classList.toggle('active', turn === 3);
}

function executeCpuTurn() {
  if (isGameOver) return;

  // プレイヤーが手札2枚以下でBUSHU未宣言のまま、CPUが実際にカードを出す／引くアクションを迎えた場合のみ指摘ペナルティ発生
  if (players[0].length <= 2 && !bushuDeclared[0]) {
    const noticeSpeaker = turn === 1 ? 2 : 1;
    triggerCpuNotice(noticeSpeaker, "プレイヤー！ BŪSHU! を言い忘れたな！ ペナルティ1枚！", () => {
      drawCardsSmart(0, 1);
      renderUI();
      continueCpuTurnExecution();
    });
    return;
  }

  continueCpuTurnExecution();
}

function continueCpuTurnExecution() {
  if (isGameOver) return;
  const cpuIdx = turn;
  const hand = players[cpuIdx];

  if (hand.length <= 2 && !bushuDeclared[cpuIdx]) {
    if (Math.random() < 0.85) {
      triggerCpuPressBushuButton(cpuIdx);
    }
  }

  if (pendingDrawCount > 0) {
    const counterDrawIdx = hand.findIndex(c => c.type === 'SPECIAL' && (c.effect === 'DRAW2' || c.effect === 'DRAW4'));
    if (counterDrawIdx > -1) {
      const played = hand.splice(counterDrawIdx, 1);
      checkCpuMissedBushuAndProcess(played, cpuIdx);
      return;
    } else {
      const hitAmount = pendingDrawCount; drawCardsSmart(cpuIdx, pendingDrawCount); pendingDrawCount = 0;
      triggerDrawHitBanner(cpuIdx, hitAmount, () => { checkWinOrNextTurn(); }); return;
    }
  }

  const specialIdx = hand.findIndex(c => c.type === 'SPECIAL');
  if (specialIdx > -1) {
    const played = hand.splice(specialIdx, 1);
    checkCpuMissedBushuAndProcess(played, cpuIdx);
    return;
  }

  const topBushuKey = wildSpecifiedBushu || topCard.bushu;

  for (let i = 0; i < hand.length; i++) {
    for (let j = i + 1; j < hand.length; j++) {
      for (let k = j + 1; k < hand.length; k++) {
        const match3 = findMatchingKanji([hand[i].value, hand[j].value, hand[k].value]);
        if (match3) {
          const hasCommon = activeParts.length === 0 || match3.parts.some(p => activeParts.includes(p));
          const isSameBushuColor = (match3.bushu === topBushuKey);
          if (hasCommon || isSameBushuColor) {
            const played = [hand[k], hand[j], hand[i]];
            hand.splice(k, 1); hand.splice(j, 1); hand.splice(i, 1);
            checkCpuMissedBushuAndProcess(played, cpuIdx);
            return;
          }
        }
      }
    }
  }

  for (let i = 0; i < hand.length; i++) {
    for (let j = i + 1; j < hand.length; j++) {
      const match2 = findMatchingKanji([hand[i].value, hand[j].value]);
      if (match2) {
        const hasCommon = activeParts.length === 0 || match2.parts.some(p => activeParts.includes(p));
        const isSameBushuColor = (match2.bushu === topBushuKey);
        
        if (hasCommon || isSameBushuColor) {
          const played = [hand[j], hand[i]];
          hand.splice(j, 1); hand.splice(i, 1);
          checkCpuMissedBushuAndProcess(played, cpuIdx);
          return;
        }
      }
    }
  }

  drawCardsSmart(cpuIdx, 1);
  const newHand = players[cpuIdx];

  for (let i = 0; i < newHand.length; i++) {
    for (let j = i + 1; j < newHand.length; j++) {
      for (let k = j + 1; k < newHand.length; k++) {
        const match3 = findMatchingKanji([newHand[i].value, newHand[j].value, newHand[k].value]);
        if (match3) {
          const hasCommon = activeParts.length === 0 || match3.parts.some(p => activeParts.includes(p));
          const isSameBushuColor = (match3.bushu === topBushuKey);
          if (hasCommon || isSameBushuColor) {
            const played = [newHand[k], newHand[j], newHand[i]];
            newHand.splice(k, 1); newHand.splice(j, 1); newHand.splice(i, 1);
            checkCpuMissedBushuAndProcess(played, cpuIdx);
            return;
          }
        }
      }
    }
  }
  
  for (let i = 0; i < newHand.length; i++) {
    for (let j = i + 1; j < newHand.length; j++) {
      const match2 = findMatchingKanji([newHand[i].value, newHand[j].value]);
      if (match2) {
        const hasCommon = activeParts.length === 0 || match2.parts.some(p => activeParts.includes(p));
        const isSameBushuColor = (match2.bushu === topBushuKey);
        if (hasCommon || isSameBushuColor) {
          const played = [newHand[j], newHand[i]];
          newHand.splice(j, 1); newHand.splice(i, 1);
          checkCpuMissedBushuAndProcess(played, cpuIdx);
          return;
        }
      }
    }
  }

  checkWinOrNextTurn();
}

function checkCpuMissedBushuAndProcess(playedCards, cpuIdx) {
  const afterCount = players[cpuIdx].length;
  const missedBushu = (afterCount <= 2 && !bushuDeclared[cpuIdx]);

  if (missedBushu) {
    processPlayedCards(playedCards, cpuIdx);
    const noticeSpeaker = cpuIdx === 1 ? 2 : 1;
    triggerCpuNotice(noticeSpeaker, `${PLAYER_NAMES[cpuIdx]}！ BŪSHU! を言い忘れたな！ ペナルティ1枚！`, () => {
      drawCardsSmart(cpuIdx, 1);
      renderUI();
      checkWinOrNextTurn();
    });
  } else {
    processPlayedCards(playedCards, cpuIdx);
    checkWinOrNextTurn();
  }
}

function showResultModal(rankingList, isTimeUp = false) {
  const modal = document.getElementById('result-modal');
  const title = document.getElementById('result-title');
  const desc = document.getElementById('result-desc');
  const rankingTbody = document.getElementById('ranking-tbody');
  const resultTbody = document.getElementById('result-tbody');

  const winner = rankingList[0];
  const isPlayerWinner = (winner.playerIdx === 0);

  title.innerText = isPlayerWinner ? '🎉 あなたの勝ち！ BŪSHU!!' : `💻 ${PLAYER_NAMES[winner.playerIdx]} の勝ち！`;
  desc.innerText = isTimeUp ? '制限時間が経過しました。' : `${PLAYER_NAMES[winner.playerIdx]} が上がり！`;

  rankingTbody.innerHTML = '';
  rankingList.forEach((item, index) => {
    const tr = document.createElement('tr');
    if (index === 0) { tr.style.backgroundColor = 'rgba(245, 158, 11, 0.2)'; tr.style.color = '#f59e0b'; }
    tr.innerHTML = `<td>第 ${index + 1} 位</td><td>${PLAYER_NAMES[item.playerIdx]}</td><td>${item.count} 枚</td>`;
    rankingTbody.appendChild(tr);
  });

  resultTbody.innerHTML = '';
  historyCompletedKanji.forEach(item => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td style="color:#38bdf8; font-weight:bold;">${PLAYER_NAMES[item.playerIdx]}</td><td style="font-size:18px; font-weight:bold; color:#f59e0b;">${item.kanji}</td><td>${item.parts}</td><td>${item.bushu}</td>`;
    resultTbody.appendChild(tr);
  });

  modal.classList.remove('hidden');
}

function restartGame() {
  document.getElementById('result-modal').classList.add('hidden');
  initGame();
}
