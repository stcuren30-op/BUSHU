      if (bInfo) colorClass = bInfo.cssClass;
    }

    cardEl.className = `neon-card ${colorClass} ${isSelected ? 'selected' : ''}`;
    
    const rotate = (idx - (handCount - 1) / 2) * 3.5;
    cardEl.style.transform = `rotate(${rotate}deg)`;
